# Database
DATABASE_URL=postgresql://user:password@localhost:5432/pet_aggregator
# Payload
PAYLOAD_SECRET=replace-with-32-char-random
# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Telegram (OAuth widget; from BotFather)
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
# Telegram-чат для уведомлений модераторам (числовой chat_id или @username)
TELEGRAM_NOTIFY_CHAT_ID=
# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@pet-aggregator.by
# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pet-aggregator-media
R2_PUBLIC_URL=https://media.pet-aggregator.by
# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Plausible
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=pet-aggregator.by

# Cloudflare Turnstile (anti-bot)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email superadmin для жалоб и заявок приютов (Plan 4)
SUPERADMIN_EMAIL=

# §17.6: публичный Telegram-канал для автопоста срочных животных
TELEGRAM_URGENT_CHAT_ID=
# §17.6: секрет для POST /api/cron/urgency-recalc (Authorization: Bearer ...); без него роут отвечает 503
CRON_SECRET=

# IndexNow — переиндексация Яндекс/Bing при публикации (§16.7).
# Случайная hex-строка 8–128 символов; ключ для проверки отдаёт роут /indexnow-key
INDEXNOW_KEY=

# ExpressPay (express-pay.by, ЕРИП). Без EXPRESSPAY_TOKEN приём донатов выключен (форма «скоро»).
# Песочница: EXPRESSPAY_API_BASE=https://sandbox-api.express-pay.by/v1, токены в документации (bd64 ЕРИП без подписи,
# bd66 ЕРИП и bd67 карта — с секретом sandbox.expresspay.by).
EXPRESSPAY_API_BASE=https://api.express-pay.by/v1
EXPRESSPAY_TOKEN=
EXPRESSPAY_SECRET=            # секретное слово: подпись запросов и уведомлений (если включена в ЛК)
EXPRESSPAY_USE_CARD=true      # true — оплата картой (cardinvoices), false — счёт в ЕРИП (invoices)

# Tawk.to (чат поддержки) — пусто = виджет выключен
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=

# 2FA и техработы
TWOFA_ISSUER=PetAggregator
MAINTENANCE_MODE=false
EXPRESSPAY_ERIP_SERVICE_CODE=         # код услуги в дереве ЕРИП (из договора) — показывается на /help/erip/<номер>

# Бэкап БД (npm run backup:db, раз в неделю). Отдельный ПРИВАТНЫЙ бакет — не R2_BUCKET медиа.
R2_BACKUP_BUCKET=
BACKUP_RETENTION_WEEKS=8
